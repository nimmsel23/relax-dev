{
  "name": "relax-dev",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22.13"
  },
  "description": "Entspannungstrainer-Modul der Pr\u00e4ventiven Vitaltrainer-Ausbildung",
  "scripts": {
    "dev": "node scripts/dev-runner.mjs",
    "start": "python3 server.py",
    "ui:dev": "vite",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "preview": "vite preview",
    "deploy:cloud": "firebase deploy --only hosting --project fitness-aos",
    "firebase": "pnpm run build && pnpm run deploy:cloud",
    "deploy:preview": "pnpm run build && firebase hosting:channel:deploy preview --expires 24h",
    "deploy:prev": "pnpm run build && firebase hosting:channel:deploy preview --expires 24h",
    "build:preview": "pnpm run build && firebase hosting:channel:deploy preview --expires 24h",
    "build:prev": "pnpm run build && firebase hosting:channel:deploy preview --expires 24h",
    "build:native": "vite build --mode native",
    "native:sync": "pnpm run build:native && cap sync",
    "native:android": "cap open android",
    "build:android": "pnpm run native:sync && cd android && ./gradlew assembleDebug",
    "run:android": "pnpm run native:sync && cap run android",
    "tooling:biome": "pnpm dlx @biomejs/biome@2.6.6 check --formatter-enabled=true --linter-enabled=false --no-errors-on-unmatched scripts",
    "tooling:knip": "pnpm dlx knip@6.44.2 --no-progress",
    "tooling:check": "pnpm run tooling:biome && pnpm run tooling:knip",
    "tooling:biome:lint": "pnpm dlx @biomejs/biome@2.6.6 check --formatter-enabled=true --linter-enabled=true --no-errors-on-unmatched scripts"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@google/generative-ai": "^0.24.1",
    "@tanstack/react-query": "^5.107.1",
    "dotenv": "18.0.9",
    "firebase": "^13.2.0",
    "lucide-react": "^1.70.0",
    "marked": "18.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reactflow": "^11.11.4",
    "recharts": "^3.10.1",
    "yaml": "^2.9.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@vitejs/plugin-react": "6.2.1",
    "autoprefixer": "^10.6.2",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.5",
    "vite": "8.3.6",
    "vite-plugin-pwa": "^2.0.0"
  },
  "optionalDependencies": {}
}
