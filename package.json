{
  "name": "relax-dev",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "description": "Relax Centre \u2014 Entspannung & Stress-Reset (Standalone)",
  "scripts": {
    "dev": "node scripts/dev-runner.mjs",
    "start": "node server.mjs",
    "ui:dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy:cloud": "firebase deploy --only hosting --project fitness-aos",
    "firebase": "pnpm run build && pnpm run deploy:cloud",
    "deploy:preview": "pnpm run build && firebase hosting:channel:deploy preview --expires 24h",
    "deploy:prev": "pnpm run build && firebase hosting:channel:deploy preview --expires 24h",
    "build:preview": "pnpm run build && firebase hosting:channel:deploy preview --expires 24h",
    "build:prev": "pnpm run build && firebase hosting:channel:deploy preview --expires 24h"
  },
  "dependencies": {
    "@fastify/static": "^9.1.3",
    "@google/generative-ai": "^0.21.0",
    "@tanstack/react-query": "^5.100.10",
    "dotenv": "^16.4.5",
    "firebase": "^11.10.0",
    "fastify": "^5.8.5",
    "lucide-react": "^0.453.0",
    "marked": "^18.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reactflow": "^11.11.4",
    "recharts": "^3.8.1",
    "yaml": "^2.4.5",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "nodemon": "^3.1.10",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^1.3.0"
  }
}
