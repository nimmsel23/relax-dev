{
  "hosting": [
    {
      "target": "vos-relax",
      "public": "dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "/sw.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "**/*.@(js|css|woff2)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "max-age=31536000, immutable"
            }
          ]
        }
      ]
    },
    {
      "target": "relax-vos-redirect",
      "public": "hosting-redirect",
      "ignore": [
        "**/*"
      ],
      "redirects": [
        {
          "source": "/",
          "destination": "https://vos-relax.web.app/",
          "type": 301
        },
        {
          "source": "/:path*",
          "destination": "https://vos-relax.web.app/:path",
          "type": 301
        }
      ]
    }
  ]
}
